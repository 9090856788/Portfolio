{
  "name": "portfolio-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "admin",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:both": "node scripts/dev-both.js",
    "dev:all": "node scripts/dev-both.js",
    "server": "node server/index.js",
    "client": "npm run dev --workspace=client",
    "admin": "npm run dev --workspace=admin",
    "start": "node server/index.js",
    "build": "npm run build --workspace=admin && npm run build --workspace=client",
    "build:admin": "npm run build --workspace=admin",
    "build:client": "npm run build --workspace=client",
    "lint": "npm run lint --workspace=client"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@tanstack/react-query": "^5.103.1",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "react-redux": "^9.3.0",
    "swagger-ui-express": "^5.0.1"
  }
}
